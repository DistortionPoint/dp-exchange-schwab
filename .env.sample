# dp_exchange_schwab — environment variable template.
#
# This is the ONLY .env file that is committed. `.gitignore` carries
# `.env*` / `!.env.sample`; every other .env is yours and stays local.
#
#     cp .env.sample .env
#
# Secrets live in .env files and nowhere else. There is no `config/*.secret.exs` and no
# Vault layer.

# ---------------------------------------------------------------------------
# This package needs no venue credentials, and that is deliberate
# ---------------------------------------------------------------------------
#
# It does NOT handle authentication. The host does, and the host chooses which kind —
# Gemini offers an API key pair and a full OAuth 2.0 flow, and picking between them is a
# decision about an application's users and its deployment. This package signs a request
# when a caller hands it credentials and names the scheme; it never obtains, stores,
# refreshes or reads one.
#
# So there is no WEBULL App Key here. Every endpoint that would need one is declared
# `:unsupported`, tier-1 tests use in-process fakes, and tier-2 tests hit public endpoints
# only. A credential sitting in this repo would have nothing to do, and an unused
# credential is a liability with no upside.
#
# The demo environment needs no credential either, for anything this package does:
#
#     DpExchange.Gemini.get_price("BTC-USD", environment: :sandbox)

# ---------------------------------------------------------------------------
# Publishing
# ---------------------------------------------------------------------------

# Organisation key. CI publishes with the org secret; this is only for publishing by hand.
HEX_API_KEY=<your-hex-api-key>
